# CFSI Frontend Environment Template
# Duplicate this file as .env.development or .env.production as needed.

VITE_APP_ENV=development
VITE_API_BASE_URL=/api

# Cloudinary CDN Image Storage (Free Tier - 25GB Storage & Auto WebP CDN)
# Register free at https://cloudinary.com, then create an Unsigned Upload Preset in Settings -> Upload.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_FOLDER=cfsi_portal
